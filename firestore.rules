rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura de órdenes de trabajo por placa
    // Solo lectura, no escritura desde cliente
    match /ordenes_trabajo/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Ejemplo: Si tienes usuarios, protégelos
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
